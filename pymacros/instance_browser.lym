<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>Instance Browser</description>
 <version>1.0</version>
 <category>pymacros</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>false</autorun>
 <autorun-early>false</autorun-early>
 <shortcut>Ctrl+Alt+I</shortcut>
 <show-in-menu>true</show-in-menu>
 <group-name/>
 <menu-path>tools_menu.end</menu-path>
 <interpreter>python</interpreter>
 <dsl-interpreter-name/>
 <text><![CDATA[
import os
import sys

import pya

QT_USER_ROLE = 256
EXTENDED_SELECTION = 3


def _candidate_python_dirs():
    candidates = []
    try:
        candidates.append(os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "python"))
    except Exception:
        pass
    for root in [os.environ.get("KLAYOUT_HOME"), os.environ.get("IIC_KLAYOUT_HOME_OVERRIDE")]:
        if root:
            candidates.append(os.path.join(root, "salt", "InstanceBrowserPlugin", "python"))
    return candidates


for python_dir in _candidate_python_dirs():
    if os.path.isdir(python_dir) and python_dir not in sys.path:
        sys.path.insert(0, python_dir)
        break

from instance_browser_plugin.instance_browser_core import collect_instances, grouped_by_reference


_DOCK = None


def _current_view():
    mw = pya.Application.instance().main_window()
    if mw is None:
        return None
    return mw.current_view()


def _current_cellview(view):
    if view is None or view.active_cellview_index < 0:
        return None
    return view.cellview(view.active_cellview_index)


def _nth_instance(cell, wanted_index):
    for index, inst in enumerate(cell.each_inst()):
        if index == wanted_index:
            return inst
    return None


def _inst_cell_index(inst):
    try:
        return int(inst.cell_index)
    except Exception:
        pass
    try:
        return int(inst.cell.cell_index())
    except Exception:
        return None


def _object_path_for_record(layout, top_cell, cv_index, record):
    obj_path = pya.ObjectInstPath()
    obj_path.cv_index = cv_index
    cell = top_cell
    for index in record.index_path:
        inst = _nth_instance(cell, index)
        if inst is None:
            return None
        obj_path.append_path(pya.InstElement(inst))
        child_index = _inst_cell_index(inst)
        if child_index is None:
            return None
        cell = layout.cell(child_index)
        if cell is None:
            return None
    return obj_path


def _zoom_to_records(view, cv, records):
    records = list(records)
    if not records:
        return
    dbu = cv.layout().dbu
    left = min(float(record.bbox[0]) * dbu for record in records)
    bottom = min(float(record.bbox[1]) * dbu for record in records)
    right = max(float(record.bbox[2]) * dbu for record in records)
    top = max(float(record.bbox[3]) * dbu for record in records)
    width = max(0.0, right - left)
    height = max(0.0, top - bottom)
    pad = max(width, height) * 0.15
    if pad <= 0.0:
        pad = 1.0
    view.zoom_box(pya.DBox(left - pad, bottom - pad, right + pad, top + pad))


class InstanceBrowserDock(pya.QDockWidget):
    def __init__(self):
        pya.QDockWidget.__init__(self)
        self.setWindowTitle("Instance Browser")
        self._browser_widget = InstanceBrowserWidget()
        self.setWidget(self._browser_widget)

    def refresh(self):
        self._browser_widget.refresh()


class InstanceBrowserWidget(pya.QWidget):
    def __init__(self):
        pya.QWidget.__init__(self)
        self.filter_edit = pya.QLineEdit()
        self.filter_edit.setPlaceholderText("Filter by cell, parent, or path")
        self.refresh_button = pya.QPushButton("Refresh")
        self.select_button = pya.QPushButton("Select")
        self.zoom_button = pya.QPushButton("Zoom")
        self.select_zoom_button = pya.QPushButton("Select + Zoom")
        self.tree = pya.QTreeWidget()
        try:
            self.tree.setSelectionMode(pya.QAbstractItemView.ExtendedSelection)
        except Exception:
            self.tree.setSelectionMode(EXTENDED_SELECTION)
        self.tree.setColumnCount(5)
        self.tree.setHeaderLabels(["Instance", "Parent", "Path", "Trans", "BBox"])
        self._records_by_path = {}

        layout = pya.QVBoxLayout()
        controls = pya.QHBoxLayout()
        controls.addWidget(self.filter_edit)
        controls.addWidget(self.refresh_button)
        layout.addLayout(controls)
        actions = pya.QHBoxLayout()
        actions.addWidget(self.select_button)
        actions.addWidget(self.zoom_button)
        actions.addWidget(self.select_zoom_button)
        layout.addLayout(actions)
        layout.addWidget(self.tree)
        self.setLayout(layout)

        self.refresh_button.clicked(self.refresh)
        self.select_button.clicked(self.select_current)
        self.zoom_button.clicked(self.zoom_current)
        self.select_zoom_button.clicked(self.select_and_zoom_current)
        self.filter_edit.textChanged(self.refresh)
        self.tree.itemDoubleClicked(self._on_item_double_clicked)

    def refresh(self):
        view = _current_view()
        cv = _current_cellview(view)
        self.tree.clear()
        self._records_by_path = {}
        if cv is None or cv.layout() is None or cv.cell is None:
            return

        text = str(self.filter_edit.text).lower().strip()
        records = collect_instances(cv.layout(), cv.cell)
        grouped = grouped_by_reference(records)
        for ref_cell, items in grouped.items():
            visible_items = []
            for record in items:
                haystack = " ".join([record.ref_cell, record.parent_cell, record.path]).lower()
                if not text or text in haystack:
                    visible_items.append(record)
            if not visible_items:
                continue

            group_item = pya.QTreeWidgetItem([ref_cell, "", "{} instance(s)".format(len(visible_items)), "", ""])
            self.tree.addTopLevelItem(group_item)
            for record in visible_items:
                box = record.bbox
                bbox_text = "{},{},{},{}".format(box[0], box[1], box[2], box[3])
                item = pya.QTreeWidgetItem(
                    [record.label, record.parent_cell, record.path, record.trans, bbox_text]
                )
                item.setData(0, QT_USER_ROLE, record.path)
                self._records_by_path[record.path] = record
                group_item.addChild(item)
            group_item.setExpanded(True)

    def _current_item(self):
        item = self.tree.currentItem
        if callable(item):
            item = item()
        return item

    def _record_from_item(self, item):
        if item is None:
            return None
        path = item.data(0, QT_USER_ROLE)
        if path is None:
            return None
        return self._records_by_path.get(str(path))

    def _selected_items(self):
        items = self.tree.selectedItems
        if callable(items):
            items = items()
        return list(items or [])

    def _selected_records(self):
        records = []
        seen = set()
        for item in self._selected_items():
            record = self._record_from_item(item)
            if record is None or record.path in seen:
                continue
            records.append(record)
            seen.add(record.path)
        if not records:
            record = self._record_from_item(self._current_item())
            if record is not None:
                records.append(record)
        return records

    def _object_paths_for_records(self, view, cv, records):
        paths = []
        for record in records:
            obj_path = _object_path_for_record(cv.layout(), cv.cell, view.active_cellview_index, record)
            if obj_path is None:
                print("[instance-browser] could not rebuild object path: {}".format(record.path))
                continue
            paths.append(obj_path)
        return paths

    def select_current(self, *args):
        records = self._selected_records()
        if not records:
            return
        view = _current_view()
        cv = _current_cellview(view)
        if view is None or cv is None:
            return
        obj_paths = self._object_paths_for_records(view, cv, records)
        if not obj_paths:
            return
        view.object_selection = obj_paths
        try:
            view.update_content()
        except Exception:
            pass
        print("[instance-browser] selected {} instance(s)".format(len(obj_paths)))

    def zoom_current(self, *args):
        records = self._selected_records()
        if not records:
            return
        view = _current_view()
        cv = _current_cellview(view)
        if view is None or cv is None:
            return
        _zoom_to_records(view, cv, records)

    def select_and_zoom_current(self, *args):
        self.select_current()
        self.zoom_current()

    def _on_item_double_clicked(self, item, column):
        record = self._record_from_item(item)
        if record is None:
            return
        try:
            if item not in self._selected_items():
                self.tree.setCurrentItem(item)
        except Exception:
            pass
        self.select_and_zoom_current()


def _run():
    global _DOCK
    mw = pya.Application.instance().main_window()
    if mw is None:
        return
    if _DOCK is None:
        _DOCK = InstanceBrowserDock()
        mw.addDockWidget(pya.Qt.RightDockWidgetArea, _DOCK)
    _DOCK.show()
    _DOCK.raise_()
    _DOCK.refresh()


_run()
]]></text>
</klayout-macro>
